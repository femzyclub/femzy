# Copy to .env.local and fill in. Without these, the site runs in demo mode (sample events).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paid events are paid by GPay / UPI QR. Put the QR image at public/payments/upi-qr.jpeg (or .jpg / .png)
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=Fem Rise Club
