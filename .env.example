# Copy to .env.local and fill in. Without these, the site runs in demo mode (sample events).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. This is the Supabase service-role key; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cashfree Payment Gateway — keep these server-only. Use sandbox credentials first.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox while testing; production only after Cashfree activates the account and domain.
CASHFREE_ENV=sandbox
